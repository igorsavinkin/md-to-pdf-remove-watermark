# markdowntopdf.com API key (get from https://www.markdowntopdf.com/dashboard/api)
# Use md_test_ prefix for sandbox (produces watermarked PDFs)
# Use md_live_ prefix for production (no watermark if subscribed)
MARKDOWNTOPDF_API_KEY=md_test_your_key_here

# Watermark removal strategy: auto | local | playwright
# auto: tries local pdf-lib first, falls back to playwright
# local: only local pdf-lib removal
# playwright: only browser automation (dpdf.com)
WM_STRATEGY=auto

# Playwright fallback settings (used when WM_STRATEGY=playwright or local fails)
WM_TARGET=https://dpdf.com/remove-watermark
WM_HEADLESS=true
WM_CONCURRENT=2

# Logging
LOG_LEVEL=info

# Directories (relative to project root or absolute)
INPUT_DIR=./input
OUTPUT_DIR=./output

# Move processed .md files to input/done/ after conversion (true by default, set to false to keep them in place)
MOVE_PROCESSED=true
